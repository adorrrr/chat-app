<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>Write new chat</h3>
    <form method="POST" action="/chats">
        <input type="text" name="from" placeholder="Your username"><br><br>
        <textarea name="msg" id="">Write your message here...</textarea><br><br>
        <input type="text" name="to" placeholder="Receiver username"><br><br>
        <button>Create Chat</button>
    </form>
</body>
</html>