<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Massage</title>
</head>
<body>
    <h3>Edit your chat: <%= chat._id %></h3>
    <p>This chat was sent from <strong><%= chat.from %></strong> to <strong><%= chat.to %></strong></p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="5"> <%= chat.msg %> </textarea><br>
        <button>Update</button>
    </form>
</body>
</html>